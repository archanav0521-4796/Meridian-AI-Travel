# ==========================================
# MERIDIAN — Editorial Luxury Travel & AI Concierge
# Environment Variables Example
# ==========================================


# 1. Google Gemini API Key (Optional)
# Used for the conversational AI concierge and bespoke itinerary generation.
# If omitted or offline, the app seamlessly runs on our built-in curated knowledge engine!
# Get a free key: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# 2. OpenWeather API Key (Optional)
# Used for live meteorological telemetry and 5-day forecasts.
# If omitted, the app automatically pulls real-time satellite data from Open-Meteo with zero configuration!
# Get a key: https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY=

# 3. Unsplash Access Key (Optional)
# Used for dynamic image search queries.
# If omitted, high-resolution curated photographic assets from Unsplash CDN are delivered.
# Get a key: https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=
